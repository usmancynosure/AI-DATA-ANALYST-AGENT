# ── Claude API ────────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/. The agent loop is added in Phase 3;
# the data layer (Phase 1) runs without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Backend ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Where uploaded files and per-session DuckDB databases live.
DATA_DIR=.data

# ── SQL safety limits ─────────────────────────────────────────────────────
# Max rows any query may return before truncation.
MAX_QUERY_ROWS=10000
# Per-query wall-clock timeout (seconds).
QUERY_TIMEOUT_SECONDS=30

# ── Sandbox (Phase 2) ─────────────────────────────────────────────────────
SANDBOX_IMAGE=ai-analyst-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
