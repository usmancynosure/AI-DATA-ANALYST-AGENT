# ── Gemini API ────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey. The agent needs it; the data
# layer (upload / query / schema) runs without it.
GEMINI_API_KEY=
# Use a current Gemini model with function calling. The `-latest` aliases stay valid as
# versions rotate; older ids like gemini-2.5-* now 404 for new keys. Pro tiers usually
# need billing enabled. gemini-flash-lite-latest is the fastest/cheapest free option.
GEMINI_MODEL=gemini-flash-latest

# ── Backend ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Where uploaded files and per-session DuckDB databases live.
DATA_DIR=.data

# ── SQL safety limits ─────────────────────────────────────────────────────
# Max rows any query may return before truncation.
MAX_QUERY_ROWS=10000
# Per-query wall-clock timeout (seconds).
QUERY_TIMEOUT_SECONDS=30

# ── Sandbox (Phase 2) ─────────────────────────────────────────────────────
SANDBOX_IMAGE=ai-analyst-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
